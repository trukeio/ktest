{
  "contract": "library-rack-demo",
  "schema": 1,
  "inputs":   {"Vx": "DutSupply.Voltage", "Speed": "EngineData.EngineSpeed", "Alive": "DutStatus"},
  "monitors": {
    "alive": {"ok": "age(Alive) < 30ms and delta(Alive.counter, 16) == 1"},
    "speed": {"ok": "abs(Speed - 3000) <= 30", "modes": ["active"]},
    "supply": {"ok": "Vx > 9V"},
    "abort": {"ok": "Vx < 16V"}
  },
  "modes":    {"active": {"action": "enter_active", "settle": "200ms"}},
  "resource": "actions.txt",
  "actions":  {"enter_active": "enter_active", "leave_active": "leave_active", "reset": "reset"},
  "timeouts": {"reset": "2s"}
}
