{
  "title": "Supply bench",
  "groups": [
    {
      "instrument": "psu1",
      "label": "Bench supply / 30 V 3 A",
      "widgets": [
        {"type": "knob", "channel": "psu1.ch1.v.set", "label": "ch1 voltage", "step": 0.1, "max": 12, "x": 0, "y": 0, "w": 2, "h": 3},
        {"type": "knob", "channel": "psu1.ch1.i.set", "label": "ch1 current limit", "step": 0.01, "max": 1, "x": 2, "y": 0, "w": 2, "h": 3},
        {"type": "gauge", "channel": "psu1.ch1.meas.v", "label": "ch1 measured", "max": 12, "x": 4, "y": 0, "w": 3, "h": 3},
        {"type": "gauge", "channel": "psu1.ch1.meas.i", "label": "ch1 measured", "max": 1, "x": 7, "y": 0, "w": 3, "h": 3},
        {"type": "toggle", "channel": "psu1.ch1.out.set", "label": "ch1 output", "x": 10, "y": 0, "w": 2, "h": 2},
        {"type": "lamp", "channel": "psu1.ch1.connected", "label": "psu1 answering", "x": 10, "y": 2, "w": 2, "h": 1},
        {"type": "setpoint", "channel": "psu1.ch1.v.set", "label": "ch1 voltage, typed", "step": 0.1, "x": 0, "y": 3, "w": 3, "h": 2},
        {"type": "setpoint", "channel": "psu1.ch2.v.set", "label": "ch2 voltage", "x": 3, "y": 3, "w": 3, "h": 2},
        {"type": "toggle", "channel": "psu1.ch2.out.set", "label": "ch2 output", "x": 6, "y": 3, "w": 3, "h": 2},
        {"type": "lamp", "channel": "psu1.ch1.out.applied", "label": "ch1 on", "x": 9, "y": 3, "w": 3, "h": 1},
        {"type": "plot", "channels": ["psu1.ch1.meas.v", "psu1.ch1.meas.i"], "window": 20, "x": 0, "y": 5, "w": 12, "h": 4}
      ]
    }
  ]
}
